{
  // Config do Worker do atende-ai-landing.
  //
  // A Cloudflare gerou este arquivo via PR de autoconfig. Ajustamos pra
  // que o Worker `src/index.js` rode (trata /api/lead) E sirva os
  // estáticos de `public/` via binding ASSETS. Sem o `main` e o binding,
  // o projeto ficava "static-only" e nem aceitava Variables/Secrets.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atende-ai-landing",
  "main": "src/index.js",
  "compatibility_date": "2026-05-29",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Variáveis não-sensíveis. PRECISAM ficar aqui — `wrangler deploy` reseta
  // variáveis plaintext configuradas via dashboard a cada deploy.
  // Apenas `RESEND_API_KEY` fica como Secret no dashboard (esse persiste).
  "vars": {
    "RESEND_FROM": "atende-ai@notificacoes.codertec.com.br",
    "RESEND_LEAD_TO": "codertec.ia@gmail.com"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
}
